<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/n_session" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:singleLine="true"/>
    <ImageView android:id="@+id/n_sbar" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY"/>
    <TextView android:id="@+id/n_week" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" android:singleLine="true"/>
</LinearLayout>
