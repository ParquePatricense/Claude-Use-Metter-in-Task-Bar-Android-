<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/widget_bg" android:scaleType="fitXY"/>
<LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
<ViewFlipper android:id="@+id/w_flip" android:layout_width="wrap_content" android:layout_height="match_parent"  android:flipInterval="900" android:autoStart="true">
<ImageView android:id="@+id/w_ring" android:layout_width="wrap_content" android:layout_height="match_parent" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
<ImageView android:id="@+id/w_ring2" android:layout_width="wrap_content" android:layout_height="match_parent" android:adjustViewBounds="true" android:scaleType="fitCenter"/>
</ViewFlipper>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
<TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text=""/>
<TextView android:id="@+id/w_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp"  android:singleLine="true" android:ellipsize="end" android:text=""/>
</LinearLayout>
</LinearLayout>
</FrameLayout>
